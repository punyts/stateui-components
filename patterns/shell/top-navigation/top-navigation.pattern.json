{
    "summary": "An app frame with the title, a menu of screens and actions in a header bar that stacks on a phone",
    "purposes": ["app with a menu bar along the top", "website header with links to pages", "horizontal menu above the content"],
    "tree": {
        "component": "page",
        "navPosition": "none",
        "_title": "My app",
        "header": {
            "component": "panel",
            "layout": { "type": "grid", "cols": 3, "collapseBelow": "md" },
            "children": {
                "title": { "component": "text", "textRole": "title", "_text": "My app" },
                "menu": {
                    "component": "nav",
                    "orientation": "horizontal",
                    "children": { "home": { "component": "menuItem", "_label": "Home", "screen": "home" } }
                },
                "actions": { "component": "toolbar", "align": "end", "children": {} }
            }
        },
        "children": { "screen": { "component": "outlet" } },
        "footer": { "component": "toolbar", "children": { "note": { "component": "text", "textRole": "caption", "_text": "My app" } } }
    },
    "slots": {
        "menu": { "path": "header.children.menu.children", "description": "One menuItem per screen: set its screen to the screen name and its _label" },
        "headerActions": { "path": "header.children.actions.children", "description": "Buttons at the end of the header, such as sign in or the bag" },
        "footer": { "path": "footer.children", "description": "The content of the footer, such as a copyright line or links" }
    },
    "params": {
        "title": { "type": "string", "default": "My app", "paths": ["_title", "header.children.title._text", "footer.children.note._text"], "description": "The name of the app in the header" }
    }
}
