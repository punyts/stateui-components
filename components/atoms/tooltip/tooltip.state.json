{
    "summary": "A short text label shown next to another node on hover and keyboard focus",
    "category": "overlays",
    "purposes": ["explain an icon button on hover", "show a short hint on keyboard focus", "name an action that has no label"],
    "tokens": {
        "padding": "{space.inset.sm}",
        "radius": "{radius.sm}",
        "maxsize": "calc({size.control.md} * 8)"
    },
    "properties": {
        "side": { "type": "string", "values": ["top", "bottom", "start", "end"], "default": "top", "reflect": true },
        "delay": { "type": "number", "default": 500 },
        "_text": { "type": "string", "kind": "content", "default": "Tooltip" },
        "trigger": { "type": "node" }
    }
}
