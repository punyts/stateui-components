{
    "summary": "A bare dropdown of options from data or a translated static map, single or multiple, with no visible label",
    "category": "forms",
    "purposes": ["pick one value from a dropdown in a cell", "choose from a short list in a toolbar", "filter a table from a compact dropdown"],
    "tokenGroup": "control",
    "tokens": {
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "radius": "{radius.md}",
        "border": "{border.width.thin}",
        "padding": { "inline": "{space.inset.sm}" }
    },
    "shared": { "size": { "default": "md" } },
    "events": ["change"],
    "commands": ["focus", "clear"],
    "properties": {
        "options": {
            "type": ["array", "map"],
            "default": [],
            "items": { "_label": { "type": "string", "kind": "content" } }
        },
        "optionValue": { "type": "string", "default": "value" },
        "optionLabel": { "type": "string", "default": "label" },
        "multiple": { "type": "boolean", "default": false },
        "value": { "type": "any", "default": "" },
        "disabled": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "_label": { "type": "string", "kind": "content", "default": "Select" }
    }
}
