{
    "summary": "A bare checkbox with no visible label",
    "category": "forms",
    "purposes": ["tick a box in a table row", "select rows for a bulk action", "mark a task as complete", "toggle a yes or no choice without a label"],
    "tokenGroup": "control",
    "tokens": {
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "radius": "{radius.md}",
        "border": "{border.width.thin}",
        "padding": { "inline": "{space.inset.sm}" }
    },
    "shared": { "size": { "default": "md" } },
    "events": ["change"],
    "commands": ["focus", "clear"],
    "properties": {
        "checked": { "type": "boolean", "default": false },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "_label": { "type": "string", "kind": "content", "default": "Checkbox" }
    }
}
