{
    "summary": "Cards in columns from a root, joined by curved edges and links across; the consumer draws each card",
    "category": "graphics",
    "purposes": ["draw a mind map from one root", "map how the parts of a system link up", "show a hierarchy as cards joined by lines", "lay out an org chart sideways"],
    "tokenGroup": "treediagram",
    "events": ["select", "open", "layout"],
    "tokens": {
        "edge": "{color.border.strong}",
        "link": "{color.accent.base}",
        "selected": "{color.accent.base}",
        "radius": "{radius.md}"
    },
    "properties": {
        "nodes": { "type": ["array", "object"] },
        "links": { "type": "array", "default": [] },
        "card": { "type": "node", "row": true },
        "key": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "id" },
        "parentField": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "parent" },
        "wrapField": { "type": "string", "validators": { "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "wrap" },
        "selected": { "type": "string", "default": "" },
        "twoSided": { "type": "boolean", "default": false },
        "columns": { "type": "integer", "validators": { "range": { "min": 0 } }, "default": 0 },
        "leafBlock": { "type": "number", "validators": { "range": { "min": 0 } }, "default": 0 },
        "linksShown": { "type": "string", "values": ["selected", "always"], "default": "selected" },
        "spacing": { "type": "string", "values": ["sm", "md", "lg"], "default": "md" },
        "_label": { "type": "string", "kind": "content", "default": "Diagram" },
        "edges": { "type": "object", "default": {}, "runtime": true },
        "width": { "type": "number", "default": 0, "runtime": true },
        "height": { "type": "number", "default": 0, "runtime": true }
    }
}
