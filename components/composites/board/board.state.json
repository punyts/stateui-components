{
    "summary": "A kanban board: a column per value of a record field, each a recordList of cards that move by pointer and keyboard",
    "tokenGroup": "board",
    "events": ["move"],
    "tokens": {
        "card": "calc({size.control.md} * 2)",
        "column": "calc({size.control.md} * 8)",
        "height": "calc({size.control.md} * 10)"
    },
    "properties": {
        "key": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "id" },
        "columnField": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "column" },
        "orderField": { "type": "string", "validators": { "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "" },
        "labelField": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "title" },
        "columns": {
            "type": "map",
            "default": {},
            "items": {
                "_title": { "type": "string", "kind": "content", "default": "" },
                "limit": { "type": "integer", "validators": { "range": { "min": 0 } }, "default": 0 }
            }
        },
        "cardHeight": { "type": "string", "values": ["sm", "md", "lg"], "default": "md", "reflect": true },
        "records": { "type": ["array", "object"] },
        "card": { "type": "node", "row": true },
        "_limitExceeded": { "type": "string", "kind": "content", "default": "Limit exceeded" },
        "_moveAnnouncements": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "pickedUp": "{name} picked up, position {position} of {count} in {column}. Use the arrow keys to move it, Space to drop it and Escape to cancel.",
                "moved": "{name} moved to position {position} of {count} in {column}.",
                "dropped": "{name} dropped at position {position} of {count} in {column}.",
                "cancelled": "Move of {name} cancelled."
            }
        },
        "announcement": { "type": "string", "default": "", "runtime": true },
        "cols": { "type": "object", "default": {}, "runtime": true },
        "orders": { "type": "object", "default": {}, "runtime": true }
    }
}
