{
    "summary": "Draws only the visible records as a grid of cards through a small pool of recycled item nodes",
    "category": "data",
    "purposes": ["show products for sale as a grid of cards", "browse a gallery of items with pictures", "scroll a large catalogue of tiles"],
    "commands": ["scrollTo", "scrollToEnd"],
    "tokenGroup": "recordgrid",
    "tokens": {
        "itemmin": "calc({size.control.md} * 6)",
        "itemheight": "calc({size.control.md} * 4)"
    },
    "properties": {
        "key": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "id" },
        "overscan": { "type": "integer", "validators": { "range": { "min": 0, "max": 20 } }, "default": 2 },
        "follow": { "type": "boolean", "default": false },
        "records": { "type": ["array", "object"] },
        "order": { "type": "array" },
        "row": { "type": "node", "row": true },
        "count": { "type": "integer", "default": 0, "runtime": true },
        "atEnd": { "type": "boolean", "default": true, "runtime": true },
        "colCount": { "type": "integer", "default": 1, "runtime": true },
        "rowCount": { "type": "integer", "default": 0, "runtime": true },
        "contentHeight": { "type": "number", "default": 0, "runtime": true },
        "slots": { "type": "object", "default": {}, "runtime": true }
    }
}
