{
    "summary": "Draws only the visible records of a long list through a small pool of recycled row nodes",
    "events": ["range"],
    "commands": ["scrollTo"],
    "shared": { "density": {} },
    "tokenGroup": "recordlist",
    "tokens": {
        "row": "calc({size.control.md} * {density.factor})"
    },
    "properties": {
        "key": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "id" },
        "rowHeight": { "type": "string", "values": ["sm", "md", "lg"], "default": "md", "reflect": true },
        "overscan": { "type": "integer", "validators": { "range": { "min": 0, "max": 20 } }, "default": 5 },
        "records": { "type": ["array", "object"] },
        "order": { "type": "array" },
        "role": { "type": "string", "values": ["list", "listbox", "table", "rowgroup", "tree"], "default": "list", "reflect": true },
        "rowIndexOffset": { "type": "integer", "default": 0, "validators": { "range": { "min": 0 } } },
        "selected": { "type": ["string", "number", "array"] },
        "multiselectable": { "type": "boolean", "default": false },
        "selectable": { "type": "boolean", "default": false },
        "loading": { "type": "boolean", "default": false, "reflect": true },
        "total": { "type": "integer", "validators": { "range": { "min": 0 } } },
        "row": { "type": "node", "row": true },
        "empty": { "type": "node" },
        "ariaRowcount": { "type": "integer", "reflect": true },
        "count": { "type": "integer", "default": 0, "runtime": true },
        "slots": { "type": "object", "default": {}, "runtime": true },
        "loadingRows": { "type": "integer", "default": 0, "runtime": true },
        "loadingFirst": { "type": "integer", "default": 0, "runtime": true }
    }
}
