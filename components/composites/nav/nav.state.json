{
    "summary": "The application navigation: menu items with an active one, header and footer slots; overflow scroll keeps one row",
    "category": "navigation",
    "purposes": ["move between the screens of an app", "show the main menu with the active screen", "switch between sections from a sidebar"],
    "events": ["select"],
    "tokens": {
        "width": "calc({size.control.md} * 6)",
        "padding": "{space.inset.sm}",
        "gap": "{space.gap.sm}"
    },
    "properties": {
        "orientation": { "type": "string", "values": ["vertical", "horizontal"], "default": "vertical", "reflect": true },
        "active": { "type": "string", "default": "" },
        "overflow": { "type": "string", "values": ["wrap", "scroll"], "default": "wrap", "reflect": true },
        "collapsed": { "type": "boolean", "default": false, "reflect": true },
        "_label": { "type": "string", "kind": "content", "default": "Main navigation" },
        "header": { "type": "node" },
        "footer": { "type": "node" }
    }
}
