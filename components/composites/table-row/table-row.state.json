{
    "summary": "One row of a table: the cells the table builds from its columns for each visible record",
    "properties": {
        "cells": {
            "type": "map",
            "items": {
                "align": { "type": "string", "values": ["start", "center", "end"], "default": "start" },
                "format": { "type": "string", "values": ["number", "percent", "currency", "duration"] },
                "currency": { "type": "string", "validators": { "pattern": "^[A-Z]{3}$" } },
                "fractionDigits": { "type": "integer", "validators": { "range": { "min": 0, "max": 20 } } },
                "value": { "type": "any" },
                "text": { "type": "string", "default": "" },
                "content": { "type": "object" }
            },
            "default": {}
        }
    }
}
