{
    "summary": "The root of an application: header, navigation, main content and footer; the nav collapses on narrow pages",
    "category": "layout",
    "purposes": ["frame an app with header, menu and content", "hold the main screen of an application", "collapse the side menu on a phone"],
    "layout": true,
    "tokens": {
        "padding": "{space.inset.md}",
        "gap": "{space.gap.md}"
    },
    "properties": {
        "navPosition": { "type": "string", "values": ["start", "top", "none"], "default": "start", "reflect": true },
        "navBreakpoint": { "type": "integer", "default": 768, "validators": { "range": { "min": 0 } } },
        "navOpen": { "type": "boolean", "default": false, "reflect": true },
        "compact": { "type": "boolean", "default": false, "reflect": true, "runtime": true },
        "maxWidth": { "type": "string", "values": ["none", "md", "lg", "xl"], "default": "none", "reflect": true },
        "_title": { "type": "string", "kind": "content", "default": "" },
        "_navLabel": { "type": "string", "kind": "content", "default": "Menu" },
        "header": { "type": "node" },
        "nav": { "type": "node" },
        "footer": { "type": "node" },
        "toasts": { "type": "node", "default": { "component": "toastRegion" } }
    }
}
