{
    "component": "modal",
    "summary": "A dialog holding a form, with save and cancel, that closes when the form is submitted",
    "category": "forms",
    "purposes": ["add a new record in a dialog with a save button", "edit an item in a popup form", "collect a few fields without leaving the page"],
    "_title": "Edit",
    "body": {
        "component": "form",
        "children": {
            "name": { "component": "textField", "_label": "Name", "required": true }
        },
        "on": { "submitted": [{ "command": "close", "target": "^formDialog" }] }
    },
    "footer": {
        "component": "toolbar",
        "align": "end",
        "children": {
            "cancel": {
                "component": "button",
                "variant": "ghost",
                "_title": "Cancel",
                "on": { "press": [{ "command": "close", "target": "^formDialog" }] }
            },
            "save": {
                "component": "button",
                "_title": "Save",
                "on": { "press": [{ "command": "submit", "target": "^formDialog.body" }] }
            }
        }
    },
    "exposes": {
        "_title": "Dialog title",
        "body.children": "The fields of the form, keyed by the name that appears in the submitted values: replace the map (null removes the default field) and link each field's value to $.data",
        "footer.children.save._title": "Save button text"
    }
}
