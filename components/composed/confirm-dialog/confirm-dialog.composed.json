{
    "component": "modal",
    "width": "sm",
    "_title": "Are you sure?",
    "body": { "component": "text", "_text": "This cannot be undone." },
    "footer": {
        "component": "toolbar",
        "align": "end",
        "children": {
            "cancel": {
                "component": "button",
                "variant": "ghost",
                "_title": "Cancel",
                "on": { "press": [{ "command": "close", "target": "^confirmDialog" }] }
            },
            "confirm": {
                "component": "button",
                "tone": "danger",
                "_title": "Delete",
                "on": { "press": [{ "command": "close", "target": "^confirmDialog" }] }
            }
        }
    },
    "exposes": {
        "_title": "Dialog title",
        "body._text": "The question the dialog asks",
        "footer.children.confirm._title": "Confirm button text",
        "footer.children.confirm.tone": "Confirm button tone",
        "footer.children.confirm.on.press": "What confirming does: a list that replaces the default whole, so a minion keeps the close command (target ^confirmDialog) first and adds its own commands after it"
    }
}
