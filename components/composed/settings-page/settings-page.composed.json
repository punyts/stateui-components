{
    "component": "page",
    "summary": "A settings screen: a side menu of sections and a form for the chosen section",
    "category": "layout",
    "purposes": ["build a settings screen with sections", "change account preferences", "group options under a side menu"],
    "navPosition": "start",
    "_title": "Settings",
    "nav": {
        "component": "nav",
        "children": {
            "general": {
                "component": "menuItem",
                "_label": "General",
                "on": {
                    "press": [
                        { "command": "set", "target": "^settingsPage.children.general.hidden", "value": false },
                        { "command": "set", "target": "^settingsPage.children.notifications.hidden", "value": true },
                        { "command": "set", "target": "^settingsPage.children.appearance.hidden", "value": true }
                    ]
                }
            },
            "notifications": {
                "component": "menuItem",
                "_label": "Notifications",
                "on": {
                    "press": [
                        { "command": "set", "target": "^settingsPage.children.general.hidden", "value": true },
                        { "command": "set", "target": "^settingsPage.children.notifications.hidden", "value": false },
                        { "command": "set", "target": "^settingsPage.children.appearance.hidden", "value": true }
                    ]
                }
            },
            "appearance": {
                "component": "menuItem",
                "_label": "Appearance",
                "on": {
                    "press": [
                        { "command": "set", "target": "^settingsPage.children.general.hidden", "value": true },
                        { "command": "set", "target": "^settingsPage.children.notifications.hidden", "value": true },
                        { "command": "set", "target": "^settingsPage.children.appearance.hidden", "value": false }
                    ]
                }
            }
        }
    },
    "children": {
        "general": {
            "component": "panel",
            "_title": "General",
            "children": {
                "form": {
                    "component": "form",
                    "children": {
                        "name": { "component": "textField", "_label": "Display name", "required": true },
                        "email": { "component": "textField", "_label": "Email address" }
                    },
                    "actions": { "component": "button", "_title": "Save", "on": { "press": { "command": "submit", "target": "$parent" } } }
                }
            }
        },
        "notifications": {
            "component": "panel",
            "_title": "Notifications",
            "hidden": true,
            "children": {
                "form": {
                    "component": "form",
                    "children": {
                        "email": { "component": "switchField", "_label": "Email me about activity" },
                        "digest": { "component": "textField", "_label": "Digest time", "required": true }
                    },
                    "actions": { "component": "button", "_title": "Save", "on": { "press": { "command": "submit", "target": "$parent" } } }
                }
            }
        },
        "appearance": {
            "component": "panel",
            "_title": "Appearance",
            "hidden": true,
            "children": {
                "form": {
                    "component": "form",
                    "children": {
                        "theme": {
                            "component": "selectField",
                            "_label": "Theme",
                            "value": "light",
                            "options": {
                                "light": { "_label": "Light" },
                                "dark": { "_label": "Dark" }
                            }
                        }
                    },
                    "actions": { "component": "button", "_title": "Save", "on": { "press": { "command": "submit", "target": "$parent" } } }
                }
            }
        }
    },
    "exposes": {
        "_title": "Page title",
        "nav.children": "The navigation items, one per section. Each item press shows its panel and hides the others, so a new section needs a nav item, a panel and a line in every item on list",
        "children": "The section panels, each holding a form: replace a form children to change its settings, link each field value to $.data, and act on the form submitted event with on"
    }
}
