{
    "summary": "A labelled slider for a number or, with range, a low and high pair, with step, marks and a formatted value",
    "category": "forms",
    "purposes": ["set a price band between a low and high price", "choose a range between two numbers", "adjust a value by dragging", "set a volume or percentage"],
    "events": ["change", "invalid", "valid"],
    "commands": ["validate", "reset", "focus", "clear"],
    "tokenGroup": "field",
    "tokens": {
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "error": { "color": "{color.danger.base}" },
        "label": { "gap": "{space.gap.sm}", "width": "calc({size.control.lg} * 3)" },
        "help": { "size": "{text.caption.size}" }
    },
    "shared": { "size": { "default": "md" }, "density": {} },
    "properties": {
        "value": { "type": ["number", "array", "string"], "default": "" },
        "min": { "type": "number", "default": 0 },
        "max": { "type": "number", "default": 100 },
        "step": { "type": "number", "default": 1, "validators": { "range": { "min": 0 } } },
        "range": { "type": "boolean", "default": false, "reflect": true },
        "showValue": { "type": "boolean", "default": true },
        "format": { "type": "string", "values": ["number", "percent", "duration"], "default": "number" },
        "marks": {
            "type": "map",
            "default": {},
            "items": {
                "_label": { "type": "string", "kind": "content", "default": "" }
            }
        },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "titlePosition": { "type": "string", "values": ["top", "left", "inner", "hidden"], "default": "top", "reflect": true },
        "width": { "type": ["string", "integer"], "default": "fill" },
        "required": { "type": "boolean", "default": false },
        "error": { "type": "string", "default": "", "runtime": true },
        "touched": { "type": "boolean", "default": false, "runtime": true },
        "dirty": { "type": "boolean", "default": false, "runtime": true },
        "locked": { "type": "boolean", "default": false, "runtime": true },
        "message": { "type": "string", "default": "", "runtime": true },
        "low": { "type": "number", "default": 0, "runtime": true },
        "high": { "type": "number", "default": 0, "runtime": true },
        "lowPercent": { "type": "number", "default": 0, "runtime": true },
        "highPercent": { "type": "number", "default": 0, "runtime": true },
        "lowText": { "type": "string", "default": "", "runtime": true },
        "highText": { "type": "string", "default": "", "runtime": true },
        "valueText": { "type": "string", "default": "", "runtime": true },
        "_label": { "type": "string", "kind": "content", "default": "Label" },
        "_help": { "type": "string", "kind": "content", "default": "" },
        "_low": { "type": "string", "kind": "content", "default": "Minimum" },
        "_high": { "type": "string", "kind": "content", "default": "Maximum" },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "This field is required",
                "min": "Too small",
                "max": "Too large",
                "step": "Not a valid step"
            }
        }
    }
}
