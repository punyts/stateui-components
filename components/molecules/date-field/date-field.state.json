{
    "summary": "A labelled date field that writes an ISO date (YYYY-MM-DD), with optional earliest and latest dates",
    "category": "forms",
    "purposes": ["enter a single date", "pick a birthday or due date", "set a deadline with earliest and latest dates"],
    "events": ["change", "invalid", "valid"],
    "commands": ["validate", "reset", "focus", "clear"],
    "tokenGroup": "field",
    "tokens": {
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "error": { "color": "{color.danger.base}" },
        "label": {
            "gap": "{space.gap.sm}",
            "width": "calc({size.control.lg} * 3)"
        },
        "help": {
            "size": "{text.caption.size}"
        }
    },
    "shared": {
        "size": {
            "default": "md"
        },
        "density": {}
    },
    "properties": {
        "value": {
            "type": "string",
            "default": ""
        },
        "disabled": {
            "type": "boolean",
            "default": false
        },
        "readonly": {
            "type": "boolean",
            "default": false
        },
        "titlePosition": {
            "type": "string",
            "values": ["top", "left", "inner", "hidden"],
            "default": "top",
            "reflect": true
        },
        "width": {
            "type": ["string", "integer"],
            "default": "fill"
        },
        "required": {
            "type": "boolean",
            "default": false
        },
        "min": {
            "type": "string",
            "default": ""
        },
        "max": {
            "type": "string",
            "default": ""
        },
        "error": {
            "type": "string",
            "default": "",
            "runtime": true
        },
        "touched": {
            "type": "boolean",
            "default": false,
            "runtime": true
        },
        "dirty": {
            "type": "boolean",
            "default": false,
            "runtime": true
        },
        "locked": {
            "type": "boolean",
            "default": false,
            "runtime": true
        },
        "message": {
            "type": "string",
            "default": "",
            "runtime": true
        },
        "glyph": {
            "type": "object",
            "default": {
                "name": "",
                "decorative": true
            },
            "runtime": true
        },
        "_label": {
            "type": "string",
            "kind": "content",
            "default": "Label"
        },
        "_help": {
            "type": "string",
            "kind": "content",
            "default": ""
        },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "This field is required",
                "min": "Too early",
                "max": "Too late"
            }
        }
    }
}
