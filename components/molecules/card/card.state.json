{
    "summary": "A surface with media, header, body and footer slots; interactive raises press; loading shows skeletons",
    "category": "content",
    "purposes": ["show one item as a box with a picture", "present a product with its name and price", "group a title, body and actions on a surface", "make a clickable tile for a record"],
    "shared": { "elevation": { "default": "raised" }, "density": {} },
    "layout": true,
    "events": ["press"],
    "tokens": {
        "selected": { "fill": "{color.accent.soft}", "border": "{color.accent.base}" },
        "radius": "{radius.md}",
        "padding": "{space.inset.md}",
        "gap": "{space.gap.md}"
    },
    "properties": {
        "interactive": { "type": "boolean", "default": false, "reflect": true },
        "selected": { "type": "boolean", "default": false, "reflect": true },
        "loading": { "type": "boolean", "default": false, "reflect": true },
        "padding": { "type": "string", "values": ["md", "none", "sm", "lg"], "default": "md", "reflect": true },
        "_title": { "type": "string", "kind": "content", "default": "" },
        "_subtitle": { "type": "string", "kind": "content", "default": "" },
        "media": { "type": "node" },
        "actions": { "type": "node" },
        "footer": { "type": "node" }
    }
}
