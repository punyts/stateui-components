{
    "summary": "A labelled colour field: a swatch that opens the colour picker, the hex text (#rrggbb) and optional preset swatches",
    "category": "forms",
    "purposes": ["pick a brand or theme colour", "enter a hex colour code", "choose from preset colours", "set the colour of a label or category"],
    "events": ["change", "invalid", "valid"],
    "commands": ["validate", "reset", "focus", "clear"],
    "tokenGroup": "field",
    "tokens": {
        "font": { "size": "{text.body.size}", "weight": "{text.body.weight}" },
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "error": { "color": "{color.danger.base}" },
        "label": { "gap": "{space.gap.sm}", "width": "calc({size.control.lg} * 3)" },
        "help": { "size": "{text.caption.size}" }
    },
    "shared": { "variant": { "default": "outline", "values": ["outline", "soft", "ghost"] }, "corners": {}, "size": { "default": "md" }, "density": {} },
    "properties": {
        "value": { "type": "string", "default": "", "validators": { "pattern": "^(?:#[0-9a-fA-F]{6})?$" } },
        "swatches": { "type": "array", "default": [] },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "titlePosition": { "type": "string", "values": ["top", "left", "inner", "hidden"], "default": "top", "reflect": true },
        "width": { "type": ["string", "integer"], "default": "fill" },
        "required": { "type": "boolean", "default": false },
        "error": { "type": "string", "default": "", "runtime": true },
        "touched": { "type": "boolean", "default": false, "runtime": true },
        "dirty": { "type": "boolean", "default": false, "runtime": true },
        "locked": { "type": "boolean", "default": false, "runtime": true },
        "message": { "type": "string", "default": "", "runtime": true },
        "presets": { "type": "object", "default": {}, "runtime": true },
        "_label": { "type": "string", "kind": "content", "default": "Colour" },
        "_help": { "type": "string", "kind": "content", "default": "" },
        "_pick": { "type": "string", "kind": "content", "default": "Open the colour picker" },
        "_swatches": { "type": "string", "kind": "content", "default": "Preset colours" },
        "_swatch": { "type": "string", "kind": "content", "default": "Use {color}" },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "This field is required",
                "pattern": "Enter a colour as # and six hex digits"
            }
        }
    }
}
