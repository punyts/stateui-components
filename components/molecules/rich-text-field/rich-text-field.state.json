{
    "summary": "A labelled rich-text editor writing block JSON: headings, lists, checks, quotes, code, tables, images and mentions",
    "category": "forms",
    "purposes": ["write formatted notes with headings and lists", "write text with links pasted from documents", "edit a rich-text article with pictures and captions", "write a formatted comment with bold and italic", "keep a checklist inside a form field", "mention people with @ in a note", "insert blocks and tables from a slash menu", "review a document with comments on its text"],
    "events": ["change", "invalid", "valid", "mentionQuery", "comment"],
    "commands": ["validate", "reset", "focus", "clear"],
    "tokenGroup": "richtextfield",
    "tokens": {
        "gap": "{space.gap.sm}",
        "code": { "background": "{color.surface.sunken}" },
        "check": { "fill": "{color.accent.base}" },
        "toolbar": { "background": "{color.surface.raised}", "active": "{color.accent.base}" },
        "link": { "width": "calc({size.control.md} * 9)" },
        "mention": { "color": "{color.accent.base}", "background": "{color.surface.sunken}" },
        "table": { "header": "{color.surface.sunken}" },
        "picker": { "active": "{color.accent.base}", "on": "{color.accent.on}" },
        "comment": { "background": "{color.warning.soft}", "active": "{color.warning.base}" },
        "image": { "selected": "{color.accent.base}", "missing": "{color.surface.sunken}" }
    },
    "shared": {
        "variant": { "default": "outline", "values": ["outline", "soft", "ghost"] },
        "corners": {},
        "size": { "default": "md" },
        "density": {}
    },
    "properties": {
        "value": { "type": "object", "default": {} },
        "toolbar": { "type": "string", "values": ["full", "compact", "none"], "default": "full", "reflect": true },
        "blocks": {
            "type": "array",
            "default": [],
            "validators": { "eachOf": ["paragraph", "heading", "bullet", "numbered", "check", "quote", "code", "divider", "table", "image"] }
        },
        "mentions": { "type": "array", "default": [] },
        "mentionValue": { "type": "string", "default": "value" },
        "mentionLabel": { "type": "string", "default": "label" },
        "comments": { "type": "object", "default": {} },
        "commentAuthor": { "type": "object", "default": {} },
        "rows": { "type": "integer", "default": 4, "validators": { "range": { "min": 1, "max": 50 } } },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "titlePosition": { "type": "string", "values": ["top", "left", "hidden"], "default": "top", "reflect": true },
        "width": { "type": ["string", "integer"], "default": "fill" },
        "required": { "type": "boolean", "default": false },
        "minLength": { "type": "integer", "default": 0, "validators": { "range": { "min": 0 } } },
        "maxLength": { "type": "integer", "default": 0, "validators": { "range": { "min": 0 } } },
        "error": { "type": "string", "default": "", "runtime": true },
        "touched": { "type": "boolean", "default": false, "runtime": true },
        "dirty": { "type": "boolean", "default": false, "runtime": true },
        "locked": { "type": "boolean", "default": false, "runtime": true },
        "message": { "type": "string", "default": "", "runtime": true },
        "selection": { "type": "object", "default": {}, "runtime": true },
        "active": { "type": "string", "default": "", "runtime": true },
        "empty": { "type": "boolean", "default": true, "runtime": true },
        "canUndo": { "type": "boolean", "default": false, "runtime": true },
        "canRedo": { "type": "boolean", "default": false, "runtime": true },
        "link": { "type": "string", "values": ["", "new", "edit"], "default": "", "runtime": true },
        "linkInvalid": { "type": "boolean", "default": false, "runtime": true },
        "picker": { "type": "string", "values": ["", "slash", "mention"], "default": "", "runtime": true },
        "comment": { "type": "string", "values": ["", "new", "open"], "default": "", "runtime": true },
        "image": { "type": "string", "values": ["", "open"], "default": "", "runtime": true },
        "imageWidth": { "type": "string", "values": ["small", "medium", "full"], "default": "full", "runtime": true },
        "upload": { "type": "string", "default": "", "runtime": true },
        "uploadFailed": { "type": "boolean", "default": false, "runtime": true },
        "_label": { "type": "string", "kind": "content", "default": "Label" },
        "_placeholder": { "type": "string", "kind": "content", "default": "" },
        "_help": { "type": "string", "kind": "content", "default": "" },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "This field is required",
                "minLength": "Too short",
                "maxLength": "Too long"
            }
        },
        "_tools": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "toolbar": "Formatting",
                "undo": "Undo",
                "redo": "Redo",
                "heading1": "Heading 1",
                "heading2": "Heading 2",
                "heading3": "Heading 3",
                "bold": "Bold",
                "italic": "Italic",
                "strike": "Strikethrough",
                "code": "Inline code",
                "bullet": "Bulleted list",
                "numbered": "Numbered list",
                "check": "Checklist",
                "outdent": "Outdent",
                "indent": "Indent",
                "quote": "Quote",
                "codeBlock": "Code block",
                "divider": "Divider",
                "checkItem": "Done",
                "link": "Link",
                "linkUrl": "Link address",
                "applyLink": "Apply",
                "removeLink": "Remove link",
                "linkInvalid": "Enter an https address, a path or a #fragment",
                "table": "Table",
                "addRow": "Add row",
                "addColumn": "Add column",
                "removeRow": "Remove row",
                "removeColumn": "Remove column",
                "removeTable": "Remove table",
                "commands": "Insert block",
                "mentions": "Mention",
                "comment": "Comment",
                "comments": "Comments",
                "commentText": "Add a comment",
                "saveComment": "Comment",
                "cancelComment": "Cancel",
                "reply": "Reply",
                "replyText": "Reply",
                "resolve": "Resolve",
                "reopen": "Reopen",
                "resolved": "Resolved",
                "deleteComment": "Delete",
                "image": "Image",
                "imageAlt": "Alt text",
                "imageCaption": "Caption",
                "imageWidth": "Width",
                "imageSmall": "Small",
                "imageMedium": "Medium",
                "imageFull": "Full",
                "removeImage": "Remove image",
                "uploading": "Uploading {files}",
                "uploadFailed": "{name} could not be uploaded",
                "imageRefused": "{name} is not a PNG, JPEG, GIF or WebP image of at most 10 MB",
                "imageLimit": "{name} was not added: the field holds at most 20 images"
            }
        }
    }
}
