{
    "summary": "An inline message with a tone, an icon, an optional title and actions, which the user can dismiss",
    "category": "feedback",
    "purposes": ["warn inside the page that a limit is exceeded", "show an inline warning or error message", "explain a problem above a form", "announce a notice the user can dismiss"],
    "events": ["close"],
    "commands": ["open", "close"],
    "shared": { "tone": { "default": "info" }, "variant": { "default": "soft" } },
    "properties": {
        "icon": { "type": "icon", "default": "" },
        "dismissible": { "type": "boolean", "default": false },
        "open": { "type": "boolean", "default": true, "reflect": true },
        "_title": { "type": "string", "kind": "content", "default": "" },
        "_text": { "type": "string", "kind": "content", "default": "Message" },
        "_closeLabel": { "type": "string", "kind": "content", "default": "Close" },
        "actions": { "type": "node" },
        "glyph": { "type": "icon", "default": "", "runtime": true },
        "closeGlyph": { "type": "icon", "default": "x", "runtime": true }
    }
}
