{
    "summary": "A labelled select whose options are a hierarchy, picked from an expandable tree in a popup",
    "category": "forms",
    "purposes": ["pick a category from a nested list", "choose a folder or department in a hierarchy", "select a region within a country", "pick one item from an outline of groups"],
    "events": ["change", "invalid", "valid", "expand"],
    "commands": ["validate", "reset", "focus", "clear", "open", "close"],
    "tokenGroup": "field",
    "tokens": {
        "font": { "size": "{text.body.size}", "weight": "{text.body.weight}" },
        "selected": { "fill": "{color.accent.base}", "on": "{color.accent.on}" },
        "error": { "color": "{color.danger.base}" },
        "label": { "gap": "{space.gap.sm}", "width": "calc({size.control.lg} * 3)" },
        "help": { "size": "{text.caption.size}" }
    },
    "shared": { "variant": { "default": "outline", "values": ["outline", "soft", "ghost"] }, "corners": {}, "size": { "default": "md" }, "density": {} },
    "properties": {
        "options": { "type": ["array", "object"], "default": [] },
        "key": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "id" },
        "parentField": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "parentId" },
        "labelField": { "type": "string", "validators": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "default": "label" },
        "leafOnly": { "type": "boolean", "default": false },
        "showPath": { "type": "boolean", "default": false },
        "expanded": { "type": "array", "default": [] },
        "value": { "type": "string", "default": "" },
        "icon": { "type": "icon", "default": "" },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "titlePosition": { "type": "string", "values": ["top", "left", "inner", "hidden"], "default": "top", "reflect": true },
        "width": { "type": ["string", "integer"], "default": "fill" },
        "required": { "type": "boolean", "default": false },
        "error": { "type": "string", "default": "", "runtime": true },
        "touched": { "type": "boolean", "default": false, "runtime": true },
        "dirty": { "type": "boolean", "default": false, "runtime": true },
        "locked": { "type": "boolean", "default": false, "runtime": true },
        "message": { "type": "string", "default": "", "runtime": true },
        "glyph": { "type": "object", "default": { "name": "", "decorative": true }, "runtime": true },
        "text": { "type": "string", "default": "", "runtime": true },
        "fullPath": { "type": "string", "default": "", "runtime": true },
        "open": { "type": "boolean", "default": false, "runtime": true },
        "rows": { "type": "object", "default": {}, "runtime": true },
        "count": { "type": "integer", "default": 0, "runtime": true },
        "activeId": { "type": "string", "default": "", "runtime": true },
        "_label": { "type": "string", "kind": "content", "default": "Label" },
        "_placeholder": { "type": "string", "kind": "content", "default": "Choose" },
        "_help": { "type": "string", "kind": "content", "default": "" },
        "_empty": { "type": "string", "kind": "content", "default": "No options" },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "This field is required"
            }
        }
    }
}
