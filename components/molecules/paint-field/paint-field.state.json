{
    "summary": "A labelled field to paint with brush, eraser, shapes and fill, with undo, redo and clear; the value is a PNG file",
    "category": "forms",
    "purposes": ["capture a handwritten signature", "sketch a drawing by hand", "mark up a picture with a brush", "draw freehand with a pen or finger", "paint a quick doodle to attach"],
    "events": ["changed", "change", "invalid", "valid"],
    "commands": ["validate", "reset", "focus", "undo", "redo", "clear"],
    "tokenGroup": "paintfield",
    "tokens": {
        "surface": "{color.surface.base}",
        "border": "{color.border.strong}",
        "toolbar": "{color.surface.sunken}"
    },
    "properties": {
        "value": { "type": "object", "default": {} },
        "width": { "type": "integer", "default": 480, "validators": { "range": { "min": 1, "max": 4096 } } },
        "height": { "type": "integer", "default": 200, "validators": { "range": { "min": 1, "max": 4096 } } },
        "background": { "type": ["string", "object"], "validators": { "color": true, "fileRef": { "types": ["image/png", "image/jpeg", "image/gif", "image/webp"] } } },
        "tools": { "type": "array", "default": ["brush", "eraser"], "validators": { "eachOf": ["brush", "eraser", "line", "rect", "ellipse", "fill"] } },
        "colors": { "type": "array", "default": ["{color.text.base}", "#d32f2f", "#1976d2", "#2e7d32"] },
        "sizes": { "type": "array", "default": [2, 4, 8, 16] },
        "tool": { "type": "string", "values": ["brush", "eraser", "line", "rect", "ellipse", "fill"], "default": "brush" },
        "color": { "type": "string", "validators": { "color": true } },
        "brushSize": { "type": "number", "validators": { "range": { "min": 1, "max": 200 } } },
        "disabled": { "type": "boolean", "default": false },
        "readonly": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": false },
        "error": { "type": "string", "default": "", "runtime": true },
        "touched": { "type": "boolean", "default": false, "runtime": true },
        "dirty": { "type": "boolean", "default": false, "runtime": true },
        "locked": { "type": "boolean", "default": false, "runtime": true },
        "message": { "type": "string", "default": "", "runtime": true },
        "toolButtons": { "type": "object", "default": {}, "runtime": true },
        "colorButtons": { "type": "object", "default": {}, "runtime": true },
        "sizeButtons": { "type": "object", "default": {}, "runtime": true },
        "_label": { "type": "string", "kind": "content", "default": "Drawing" },
        "_description": { "type": "string", "kind": "content", "default": "Draw with a mouse, pen or finger: painting needs a pointer." },
        "_toolbar": { "type": "string", "kind": "content", "default": "Painting tools" },
        "_tools": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": { "brush": "Brush", "eraser": "Eraser", "line": "Line", "rect": "Rectangle", "ellipse": "Ellipse", "fill": "Fill" }
        },
        "_color": { "type": "string", "kind": "content", "default": "Colour {value}" },
        "_size": { "type": "string", "kind": "content", "default": "Size {value}" },
        "_undo": { "type": "string", "kind": "content", "default": "Undo" },
        "_redo": { "type": "string", "kind": "content", "default": "Redo" },
        "_clear": { "type": "string", "kind": "content", "default": "Clear" },
        "_errors": {
            "type": "map",
            "items": "string",
            "kind": "content",
            "default": {
                "required": "Draw something here",
                "too_large": "The drawing is too large to save",
                "unsupported_type": "The drawing could not be saved in this format",
                "quota": "The storage limit of this app is reached",
                "offline": "The drawing could not be saved",
                "internal": "Saving the drawing failed"
            }
        }
    }
}
