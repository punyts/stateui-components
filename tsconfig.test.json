{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": [
            "vitest/globals",
            "node",
            "vite/client"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": ".",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "isolatedModules": true,
        "allowJs": true
    },
    "include": [
        "src",
        "test",
        "scripts"
    ]
}
