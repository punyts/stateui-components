{
    "properties": {
        "fill": { "type": "string", "validators": { "color": true } },
        "stroke": { "type": "string", "validators": { "color": true } },
        "strokeWidth": { "type": "number", "validators": { "range": { "min": 0 } }, "default": 1 },
        "opacity": { "type": "number", "validators": { "range": { "min": 0, "max": 1 } }, "default": 1 },
        "dash": { "type": "array", "validators": { "length": { "max": 16 } } },
        "cap": { "type": "string", "values": ["butt", "round", "square"], "default": "butt" },
        "join": { "type": "string", "values": ["miter", "round", "bevel"], "default": "miter" }
    }
}
