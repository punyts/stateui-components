{
    "properties": {
        "transition": {
            "type": "object",
            "validators": {
                "fields": {
                    "duration": { "type": ["number", "string"], "values": ["fast", "base", "slow"], "validators": { "range": { "min": 0, "max": 60000 } } },
                    "easing": { "type": "string", "values": ["standard", "enter", "exit"] }
                }
            }
        },
        "animate": {
            "type": "object",
            "validators": {
                "fields": {
                    "name": { "type": "string", "required": true, "values": ["spin", "pulse", "fade", "blink"] },
                    "duration": { "type": "number", "validators": { "range": { "min": 0, "max": 60000 } } },
                    "loop": { "type": "boolean" },
                    "delay": { "type": "number", "validators": { "range": { "min": 0, "max": 60000 } } }
                }
            }
        }
    }
}
